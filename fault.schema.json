{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VehicleFaultReported — Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "timestamp",
    "vehicleId",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "VehicleFaultReported"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "vehicleId": {
      "type": "string",
      "pattern": "^veh_[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faultCode",
        "description"
      ],
      "properties": {
        "faultCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
