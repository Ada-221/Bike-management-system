{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cebp.example/schemas/ai-mcp/v1/get-demand-by-area.input.schema.json",
  "title": "get_demand_by_area input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "areaIds", "from", "to", "bucketMinutes", "pageSize", "maxReadModelAgeSeconds"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "areaIds": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^area_[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" } },
    "from": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "to": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "bucketMinutes": { "enum": [15, 30, 60, 1440] },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cursor": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$" },
    "maxReadModelAgeSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
  },
  "description": "The service additionally enforces from < to and a maximum seven-day interval."
}
