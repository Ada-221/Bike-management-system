{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VehicleTelemetryReceived — Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "timestamp",
    "vehicleId",
    "correlationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "VehicleTelemetryReceived"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "vehicleId": {
      "type": "string",
    "pattern": "^veh_[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batteryPercent",
        "latitude",
        "longitude"
      ],
      "properties": {
        "batteryPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  }
}